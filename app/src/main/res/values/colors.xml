<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 baseline color roles (blue seed). On Android 12+ the dynamic
     wallpaper-derived scheme replaces these via DynamicColors; on older
     devices this static palette is the source of truth for both light (here)
     and dark (values-night/colors.xml) appearance. -->
<resources>
    <color name="colorPrimary">#1A5DB5</color>
    <color name="colorOnPrimary">#FFFFFF</color>
    <color name="colorPrimaryContainer">#D6E3FF</color>
    <color name="colorOnPrimaryContainer">#001B3F</color>

    <color name="colorSecondary">#565E71</color>
    <color name="colorOnSecondary">#FFFFFF</color>
    <color name="colorSecondaryContainer">#DAE2F9</color>
    <color name="colorOnSecondaryContainer">#131C2B</color>

    <color name="colorTertiary">#705575</color>
    <color name="colorOnTertiary">#FFFFFF</color>
    <color name="colorTertiaryContainer">#FAD7FF</color>
    <color name="colorOnTertiaryContainer">#28132E</color>

    <color name="colorError">#BA1A1A</color>
    <color name="colorOnError">#FFFFFF</color>
    <color name="colorErrorContainer">#FFDAD6</color>
    <color name="colorOnErrorContainer">#410002</color>

    <color name="colorBackground">#F9F9FF</color>
    <color name="colorOnBackground">#191C20</color>
    <color name="colorSurface">#F9F9FF</color>
    <color name="colorOnSurface">#191C20</color>
    <color name="colorSurfaceVariant">#E1E2EC</color>
    <color name="colorOnSurfaceVariant">#44474E</color>
    <color name="colorOutline">#74777F</color>
    <color name="colorOutlineVariant">#C4C6D0</color>

    <!-- Tonal surface levels: cards sit one step up from the background, the
         app bar sits one step above that. -->
    <color name="colorSurfaceContainerLowest">#FFFFFF</color>
    <color name="colorSurfaceContainerLow">#F2F2FA</color>
    <color name="colorSurfaceContainer">#ECECF4</color>
    <color name="colorSurfaceContainerHigh">#E6E6EE</color>
    <color name="colorSurfaceContainerHighest">#E1E1E9</color>

    <color name="colorInverseSurface">#2E3136</color>
    <color name="colorInverseOnSurface">#F0F0F7</color>
    <color name="colorInversePrimary">#AAC7FF</color>

    <!-- Legacy named colors kept for compatibility with existing references. -->
    <color name="colorDanger">#BA1A1A</color>
    <color name="colorEmptyIcon">#C4C6D0</color>
</resources>
